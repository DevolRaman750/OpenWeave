# Environment Configuration for OpenWeave Research Agents
# ============================================================
# Copy this file to .env and fill in your actual credentials
# This file is automatically loaded by test_agent.py via load_dotenv()

# ─── LANGFUSE CONFIGURATION ───────────────────────────────────
# Your Langfuse API keys for observability/tracing
# Get these from: http://localhost:3000/settings/api-keys (local)
#               https://cloud.langfuse.com/settings/api-keys (cloud)

LANGFUSE_PUBLIC_KEY=pk-lf-your-actual-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-actual-secret-key-here

# Langfuse host (local or cloud)
# Local: http://localhost:3000
# Cloud: https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000

# ─── NVIDIA/OPENAI CONFIGURATION ──────────────────────────────
# Your NVIDIA NIM API key (OpenAI-compatible format)
# Get your key from: https://build.nvidia.com/
# Note: Must start with "nvapi-"

OPENAI_API_KEY=nvapi-your-actual-api-key-here

# ─── OPTIONAL CONFIGURATION ───────────────────────────────────
# Debug mode (set to "true" to enable verbose logging)
LANGFUSE_DEBUG=false

# Environment name for traces
LANGFUSE_TRACING_ENVIRONMENT=development

# Trace sampling rate (0.0 = no traces, 1.0 = all traces)
LANGFUSE_SAMPLE_RATE=1.0
